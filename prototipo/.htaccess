# LOMAR Estilistas · subdominio de pruebas (Apache, Dinahosting)

# 1) Que Google y otros buscadores no indexen esta versión de prueba
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>

# 2) Página de inicio
DirectoryIndex index.html

# 3) Caché del navegador para imágenes, fuentes, CSS y JS (la web carga más rápido)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
</IfModule>

# 4) HTTPS: NO se fuerza desde aquí.
#    En Dinahosting hay un servidor intermedio delante y la comprobación típica
#    (RewriteCond %{HTTPS} !=on) crea un bucle de redirecciones infinito.
#    Si quieres forzar HTTPS, usa la opción del panel de Dinahosting.
